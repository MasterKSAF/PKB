# ============================================================
#  Файл .env.example – пример конфигурации сервиса парсинга
#  Скопируйте в .env и измените значения под ваше окружение
# ============================================================

# ==================== FastAPI ====================
HOST=0.0.0.0                          # Хост для запуска сервера
PORT=8087                             # Порт для запуска сервера
API_PREFIX=/api/v1                    # Префикс для API версии 1
LOG_LEVEL=info                        # Уровень логирования (DEBUG, INFO, WARNING, ERROR)

# ==================== MinIO ====================
# Обязательные параметры (без значений сервис не запустится)
MINIO_ENDPOINT=127.0.0.1:9000         # Адрес MinIO (или localhost:9000)
MINIO_ACCESS_KEY=minioadmin           # Access key для MinIO
MINIO_SECRET_KEY=minioadmin           # Secret key для MinIO
MINIO_BUCKET=files                    # Бакет для исходных документов
MINIO_IMAGE_BUCKET=images             # Бакет для извлечённых изображений
MINIO_SECURE=False                    # Использовать HTTPS для MinIO (True/False)
MINIO_TIMEOUT=30                      # Таймаут операций с MinIO (секунды)

# ==================== Лимиты ====================
MAX_FILE_SIZE_MB=500                  # Максимальный размер файла в мегабайтах
MAX_PAGES=2000                        # Максимальное количество страниц для обработки
TASK_TTL_DAYS=7                       # Время жизни результата задачи (дни)

# ==================== Таймауты пайплайна ====================
PREVIEW_TIMEOUT=600                   # Таймаут preview (секунды) – внимание, обычно 30, но сейчас 300
PIPELINE_TIMEOUT=1800                  # Таймаут всего пайплайна (секунды)
PARSER_TIMEOUT=300                    # Таймаут работы конкретного парсера (секунды)

# ===== VALIDATION TIMEOUTS =====
YARA_TIMEOUT=5
PDF_HEURISTICS_TIMEOUT=3

# ==================== Безопасность и валидация ====================
VALIDATION_GLOBAL_TIMEOUT=15          # Общий таймаут валидации (секунды)
ENABLE_YARA=False                     # Включить YARA-сканирование (требует установки yara-python)
YARA_TIMEOUT=5
REJECT_JBIG2=False                    # Отклонять файлы с фильтром JBIG2 (опасно, ломает легитимные PDF)
YARA_RULES_PATH=./app/core/yara_rules # Путь к директории с YARA-правилами
MAX_SUSPECT_FONT_STREAM_SIZE=10485760 # Максимальный размер потока шрифта для предупреждения (байт, 10 МБ)
STEP_TIMEOUT_SECONDS=60
VALIDATION_GLOBAL_TIMEOUT=15
VALIDATION_MAX_WORKERS=2

# ==================== Мок-режимы (для отладки без реальных сервисов) ====================
USE_MOCK_MINIO=False                  # Использовать мок MinIO (не требует реального хранилища)
USE_MOCK_PARSER=False                 # Использовать мок-парсер (возвращает тестовый JSON)
USE_MOCK_VALIDATOR=False              # Использовать мок-валидатор (пропускает все проверки)
MOCK_PARSER_FIXTURE_PATH=./tests/fixtures/sample_output.json             # Путь к JSON-файлу с фикстурой для мок-парсера (опционально)
MOCK_MINIO_DELAY=0                    # Искусственная задержка мок-MinIO (секунды)
MOCK_MINIO_FILE_DATA_PATH=./tests/fixtures/sample.pdf          # Путь к PDF-файлу для мок-MinIO (опционально)

# ==================== Парсинг и вывод ====================
PARSING_SCHEMA=raw_ocr_v4             # Версия схемы выходного JSON
PDF_DPI=72                            # DPI для преобразования мм в пиксели
SAVE_JSON_TO_DIR=True                # Сохранять JSON на диск (отладка)
JSON_OUTPUT_DIR=./output              # Директория для сохранения JSON (если SAVE_JSON_TO_DIR=True)
DEFAULT_EXTRACT_TABLES=True           # Извлекать таблицы по умолчанию
DEFAULT_EXTRACT_IMAGES=True           # Извлекать изображения по умолчанию
MAX_CONCURRENT_FULL_PIPELINES=2  # или число ядер CPU
USE_DOCLING_PARSER=False

# ==================== OpenTelemetry ====================
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317  # gRPC эндпоинт для OTLP экспортера
DISABLE_TELEMETRY=True

# ==================== OCR ====================
PARSER_ENABLE_OCR=true
PARSER_OCR_LANG=rus  # или eng, или комбинация rus+eng