
# FastAPI
HOST=0.0.0.0
PORT=8087
API_PREFIX=/api/v1

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<ваш_пароль_от_minioadmin>
MINIO_BUCKET=documents
MINIO_IMAGE_BUCKET=images
MINIO_SECURE=false # http (для локальной разработки)

# Лимиты
MAX_FILE_SIZE_MB=500
MAX_PAGES=2000
TASK_TTL_DAYS=7

# Настройки парсинга
DEFAULT_EXTRACT_TABLES=true
DEFAULT_EXTRACT_IMAGES=true

# Сохранение JSON результатов (опционально)
SAVE_JSON_TO_DIR=false
JSON_OUTPUT_DIR=./output