// ============================================================================
// ПРАВИЛО 1: Обнаружение внедрённого JavaScript в PDF
// ============================================================================
rule PDF_Embedded_JS {
    // Ключевое слово "rule" объявляет новое правило. "PDF_Embedded_JS" — его имя.
    // Имя должно быть уникальным в рамках файла.

    meta:
        // Блок "meta" содержит метаинформацию о правиле: описание, автор, версия и т.д.
        // Это не влияет на логику поиска, но помогает документировать правило.
        description = "Detects embedded JavaScript in PDF"
        // Ключ "description" с пояснением: правило ищет встроенный JavaScript внутри PDF.

    strings:
        // Блок "strings" определяет набор искомых образцов (строки, регулярные выражения, байтовые последовательности).
        // Каждый образец имеет имя (например, $js) и значение.

        $js = /\/JS\s+\d+\s+\d+\s+R/ nocase
        // Образец с именем $js.
        // Значение задано как регулярное выражение между слешами.
        // Регулярное выражение: /\/JS\s+\d+\s+\d+\s+R/
        //   \/JS  — экранированный слеш и литерал "JS". В PDF объекты JavaScript часто обозначаются как "/JS".
        //   \s+   — один или более пробельных символов (пробел, табуляция, перевод строки).
        //   \d+   — одна или более цифр (номер объекта).
        //   \s+   — пробелы.
        //   \d+   — цифры (номер поколения объекта).
        //   \s+   — пробелы.
        //   R     — литерал "R" (обозначает ссылку на объект в PDF).
        // Пример совпадающей строки: "/JS 12 0 R"
        // nocase — флаг "no case": игнорировать регистр символов (но здесь все символы в выражении явно указаны,
        //          он не обязателен, но может помочь, если PDF-файл использует нестандартный регистр).

        $javascript = /\/JavaScript\s+\d+\s+\d+\s+R/ nocase
        // Образец $javascript. Аналогично предыдущему, но ищет полное ключевое слово "/JavaScript".
        // В PDF может быть использовано как "/JS", так и "/JavaScript" для обозначения действий JavaScript.

    condition:
        // Блок "condition" — логическое условие, при котором правило срабатывает.
        // Если условие истинно, YARA сообщает о совпадении.
        any of them
        // Условие: "любой из образцов" (any of them) означает, что достаточно найти хотя бы один из $js или $javascript.
        // То есть если файл содержит ссылку на объект JS или JavaScript, правило срабатывает.
}

// ============================================================================
// ПРАВИЛО 2: Обнаружение словаря /EmbeddedFile (встроенный файл)
// ============================================================================
rule PDF_Embedded_File {
    meta:
        description = "Detects /EmbeddedFile dictionary"
        // Правило находит PDF, в котором присутствует ключ /EmbeddedFile (словарь встроенного файла).
        // Это может указывать на то, что внутрь PDF вложен другой файл (например, исполняемый, скрипт).

    strings:
        $embedded = "/EmbeddedFile"
        // Простая текстовая строка. Ищет точное вхождение "/EmbeddedFile" в файле.
        // Обратите внимание: отсутствует флаг nocase — поиск чувствителен к регистру.
        // В спецификации PDF ключи обычно пишутся с заглавной буквы, поэтому так безопаснее.

    condition:
        $embedded
        // Условие: образец $embedded найден. Если строка присутствует хотя бы один раз, правило срабатывает.
}

// ============================================================================
// ПРАВИЛО 3: Обнаружение действия /Launch (запуск приложения)
// ============================================================================
rule PDF_Launch_Action {
    meta:
        description = "Detects /Launch action (executable launch)"
        // Правило выявляет действие /Launch, которое в PDF позволяет запустить внешнюю программу (например, cmd.exe, скрипт).
        // Злоумышленники часто используют эту возможность для выполнения вредоносного кода.

    strings:
        $launch = "/Launch"
        // Простая строка, ищет "/Launch" (опять чувствительно к регистру).

    condition:
        $launch
        // Если в файле встречается "/Launch" — срабатывает.
}

// ============================================================================
// ПРАВИЛО 4: Эвристика на основе сигнатур шелл-кода
// ============================================================================
rule PDF_Shellcode_Heuristics {
    meta:
        description = "Suspicious byte sequences common in shellcode"
        // Правило использует эвристику: ищет заранее известные байтовые последовательности,
        // характерные для шелл-кода (например, для execve("/bin/sh") на архитектуре x86/Linux).

    strings:
        $sc1 = { 31 C0 50 68 2F 2F 73 68 68 2F 62 69 6E 89 E3 50 53 89 E1 31 D2 B0 0B CD 80 }
        // Байтовая последовательность, заданная в шестнадцатеричном виде, внутри фигурных скобок.
        // Это известный шелл-код для Linux x86, запускающий оболочку (/bin/sh) через системный вызов execve.
        // Дизассемблированный код:
        //   31 C0       xor eax, eax
        //   50          push eax
        //   68 2F 2F 73 68   push 0x68732f2f   ; "//sh"
        //   68 2F 62 69 6E   push 0x6e69622f   ; "/bin"
        //   89 E3       mov ebx, esp
        //   50          push eax
        //   53          push ebx
        //   89 E1       mov ecx, esp
        //   31 D2       xor edx, edx
        //   B0 0B       mov al, 0xb           ; syscall number for execve
        //   CD 80       int 0x80
        // Наличие такой последовательности в PDF (например, внутри потока или после декомпрессии) очень подозрительно.

        $sc2 = { 6A 0B 58 99 52 68 2F 2F 73 68 68 2F 62 69 6E 89 E3 52 53 89 E1 CD 80 }
        // Другой вариант шелл-кода для execve("/bin/sh") (немного короче):
        //   6A 0B       push 0xb
        //   58          pop eax
        //   99          cdq
        //   52          push edx
        //   68 2F 2F 73 68   push 0x68732f2f
        //   68 2F 62 69 6E   push 0x6e69622f
        //   89 E3       mov ebx, esp
        //   52          push edx
        //   53          push ebx
        //   89 E1       mov ecx, esp
        //   CD 80       int 0x80
        // Тоже выполняет запуск оболочки.

    condition:
        any of them
        // Правило срабатывает, если найдена хотя бы одна из байтовых последовательностей ($sc1 или $sc2).
}