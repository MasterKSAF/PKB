# Service
HOST=0.0.0.0
PORT=8086
API_PREFIX=/api/v1
LOG_LEVEL=info

# Registry
REGISTRY_SERVICE_URL=http://registry-service:8084
REGISTRY_TIMEOUT_SEC=10.0

# LLM
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
OPENAI_API_KEY=

# Validation
CONFIDENCE_THRESHOLD=0.55
