# RAG Search SPD local environment example
# For local host-side runs against the PKB Docker PostgreSQL port mapping.

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=pkb_neuro
POSTGRES_USER=pkb
POSTGRES_PASSWORD=pkb
POSTGRES_SCHEMA=nsi

# Embeddings
# stub is safe for local tests and does not require external API access.
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=stub
EMBEDDING_DIM=312

# Optional external/OpenAI-compatible embedding endpoint.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
