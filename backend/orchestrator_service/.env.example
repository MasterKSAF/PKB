# Orchestrator Service Configuration
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=orchestrator-service
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8081

# API
API_V1_PREFIX=/api/v1

# JWT (for token validation)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Database (default: SQLite, replace for production)
# DATABASE_URL=sqlite+aiosqlite:///./orchestrator.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/orchestrator

# Redis (used by Celery + rate limiting)
# REDIS_URL=redis://localhost:6379/0

# Celery
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ──────────────────────────────────────────────
# External Services
# ──────────────────────────────────────────────
# Leave URL empty or unset to use mock mode automatically.
# Mock Mode (true = use mocks, false = call real services)

# Registry Service
REGISTRY_SERVICE_URL=http://registry-service:8084
REGISTRY_SERVICE_MOCK=true

# RAG Service
RAG_SERVICE_URL=http://rag-service:8087
RAG_SERVICE_MOCK=true

# OCR Service
OCR_SERVICE_URL=http://ocr-service:8088
OCR_SERVICE_MOCK=true

# Parser Service
PARSER_SERVICE_URL=http://parser-service:8089
PARSER_SERVICE_MOCK=true

# Converter-Validator Service
CONVERTER_SERVICE_URL=http://converter-service:8090
CONVERTER_SERVICE_MOCK=true

# ──────────────────────────────────────────────
# Pipeline Configuration
# ──────────────────────────────────────────────
# Max retries per step before failing the pipeline
# MAX_STEP_RETRIES=3

# Base delay for exponential backoff (seconds)
# RETRY_BASE_DELAY=60

# Circuit breaker: failure threshold
# CIRCUIT_FAILURE_THRESHOLD=5

# Circuit breaker: recovery timeout (seconds)
# CIRCUIT_RECOVERY_TIMEOUT=60

# Step-specific timeouts (seconds)
# STEP_TIMEOUT_OCR=300
# STEP_TIMEOUT_PARSER=300
# STEP_TIMEOUT_CONVERTER=120
# STEP_TIMEOUT_REGISTRY=30
# STEP_TIMEOUT_RAG_INDEX=300

# Saga compensation timeout (seconds)
# SAGA_COMPENSATION_TIMEOUT=60

# Dead job detection: max time a job can be in "running" state
# MAX_JOB_RUNNING_TIME=3600
