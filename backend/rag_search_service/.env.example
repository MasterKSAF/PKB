# =============================================================================
# RAG Search Service Configuration
# =============================================================================

# --- Service ---
SERVICE_NAME=rag-search
SERVICE_VERSION=0.1.0
SERVICE_PORT=8091
LOG_LEVEL=INFO
LOG_PII_FIELDS=password,access_token,refresh_token

# --- Database ---
# PKB-стандарт (имена DB_*). POSTGRES_* поддерживается для обратной совместимости.
DB_USERNAME=rag_user
DB_PASSWORD=rag_password
DB_DATABASE=knowledge_base
DB_HOST=127.0.0.1
DB_PORT=5432  # 5433 локально, чтобы не конфликтовать с Postgres PKB
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Embedding Provider ---
# Эмбеддинги всегда через внешний OpenAI-compatible сервис (Infinity)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://infinity:7997
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ВАЖНО: Размерность должна совпадать с моделью и схемой БД (VECTOR(1024))
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=60
# EMBEDDING_INSTRUCTION=Опциональная инструкция для Qwen3-Embedding (добавляется перед query)

# --- Search ---
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=100
SEARCH_RRF_K=60
SEARCH_FETCH_MULTIPLIER=2

# --- Health Check ---
HEALTH_CHECK_TIMEOUT=5