# PKB Neuroassistant — переменные для docker compose (корень репозитория)
# Скопируйте в .env и при необходимости измените:
#   cp .env.example .env

# Порты инфраструктуры на хосте
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
TEI_PORT=18092

# Учётные данные администратора (auth service)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin1234!

# JWT (dev)
JWT_SECRET_KEY=pkb-neuroassistant-jwt-secret-key-2026-dev
JWT_ALGORITHM=HS256

# LLM (converter-validator, query)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://routerai.ru/api/v1

# Gateway
ENV=development
RATE_LIMIT_ENABLED=0
CORS_ALLOWED_ORIGINS=*

# Query service (dev mocks)
DEV_AUTH_MODE=true
MOCK_RAG_ENABLED=false
MOCK_REGISTRY_ENABLED=false
MOCK_LLM_ENABLED=true

# Monitoring profile (SigNoz demo, optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=signoz-otel-collector:4317
